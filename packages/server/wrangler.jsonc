{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bwords",
  "main": "src/worker.ts",
  // 2026-04-07 or later: the runtime answers Close frames itself, so sockets never hang in CLOSING.
  "compatibility_date": "2026-10-20",
  // The folder holds the pack and the clients (npm run assets:build). The pack is server-only (DESIGN §5.3):
  // every request reaches the Worker first, which serves a closed list of client paths; only the RoomDO reads the pack.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "vars": { "ROOM_IDLE_TIMEOUT_MIN": "30", "TV_DISCONNECT_TIMEOUT_MIN": "10" },
  "observability": { "enabled": true }
}

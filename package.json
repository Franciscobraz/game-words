{
  "name": "bwords",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "spikes/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dict:build": "node --max-old-space-size=1024 tools/dict-build/src/build.ts",
    "assets:build": "node tools/assets-build/src/build.ts",
    "deploy": "npm run assets:build && wrangler deploy -c packages/server/wrangler.jsonc",
    "bench:node": "node --expose-gc spikes/m0/src/bench-node.ts",
    "bench:cf": "node spikes/m0/src/bench-cf.ts",
    "report": "node spikes/m0/src/report.ts",
    "play": "npm run dev -w @bwords/play",
    "debug": "node tools/debug/launch.ts",
    "skills:link": "node tools/skills-link/src/link.ts",
    "postinstall": "npm run skills:link"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
